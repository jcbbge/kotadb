# ============================================================================
# KotaDB v2.0.0 - Local-Only Configuration
# ============================================================================
#
# This version of KotaDB operates exclusively in local mode using SurrealDB.
# No cloud services, authentication, or external dependencies required.
#
# Copy this file to .env to configure your local installation.
# ============================================================================

# ============================================================================
# Database Configuration
# ============================================================================

# SurrealDB connection (kotadb fork)
# Start SurrealDB with:
#   surreal start --bind 127.0.0.1:8002 --user root --pass root file://~/.kotadb/surreal.db
SURREAL_URL=ws://127.0.0.1:8002/rpc
SURREAL_NS=kotadb
SURREAL_DB=index
# SURREAL_USER=root
# SURREAL_PASS=root


# Local JSONL export directory (optional override)
# Default: .kotadb/export/ (project-local)
#
# Use this to:
#   - Export to a different location
#   - Share exports across projects
#
# KOTADB_EXPORT_PATH=/custom/path/to/export

# ============================================================================
# Server Configuration
# ============================================================================

# Port for the MCP server (optional)
# Default: 3000
PORT=3000

# ============================================================================
# Indexer Configuration
# ============================================================================

# Number of files to process in a single database transaction during indexing
# Larger batches: Fewer database calls but higher memory usage
# Smaller batches: More overhead but better progress granularity
# Default: 50
# INDEXER_BATCH_SIZE=50
